# ============================================================
# AI 社区网格员助手 · 环境变量模板
# 复制为 .env 后填写实际值。.env 已被 git 忽略，切勿提交。
# ============================================================

# ---- LLM 配置 ----
# DeepSeek / 兼容 OpenAI 协议的服务均可
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 账号数据加密（必填，缺失则服务拒绝启动）----
# AES-256-GCM 加密密钥，用于加密 secure/users.json.enc、sessions.json.enc。
# 必须为 64 位十六进制（= 32 字节）。
# 生成命令：
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# ⚠️ 安全须知：
#   1. 此密钥与 secure/ 下的加密文件必须分开备份，两者缺一不可用；
#   2. 密钥丢失 = 全部账号数据永久无法解密，无法找回；
#   3. 部署到云端后建议 chmod 600 .env，仅 root/应用用户可读。
DATA_ENCRYPTION_KEY=

# ---- 账号存储后端（可选，默认 file）----
# file      本地加密文件（secure/*.enc），本地开发与测试默认
# cloudbase 用户数据读写腾讯云 COS 对象存储（账号上云，见 DEPLOY.md「云存储模式」）
# 切换步骤：先跑 migrate_to_cloud.py 把现有账号传到云端，再改为 cloudbase 重启。
# AUTH_STORE=file
# AUTH_STORE=cloudbase

# ---- 腾讯云 COS 存储桶（AUTH_STORE=cloudbase 时必填）----
# COS_REGION=ap-guangzhou
# COS_BUCKET=你的存储桶名称（控制台-对象存储 COS 创建，建议私有读写）
# COS_SECRET_ID=腾讯云 API 密钥 ID（SecretId）
# COS_SECRET_KEY=腾讯云 API 密钥 Key（SecretKey）
#
# ⚠️ 安全须知：
#   1. 腾讯云 API 密钥等同账号权限，务必放在 .env（已 gitignore），严禁提交/外泄；
#   2. 建议创建仅限该存储桶读写的子账号密钥（最小权限）；
#   3. 存储桶保持私有，不要开放公共读。

# ---- 小区范围定位（可选，默认开启，用于住户注册/事件定位校验）----
# COMMUNITY_NAME       小区名称（展示用，默认"知·社区"）
# COMMUNITY_CENTER_LAT / COMMUNITY_CENTER_LNG  小区中心点坐标（高德地图拾取坐标）
# COMMUNITY_RADIUS_M   小区覆盖半径（米，默认 500）
#
# ⚠️ 部署注意：
#   1. 生产必须配置真实的小区中心坐标与半径，否则注册定位校验会失真；
#      获取方式：高德开放平台 → 坐标拾取器（https://lbs.amap.com/tools/picker）选中心点。
#   2. 浏览器 Geolocation 仅在安全上下文可用（HTTPS 或 localhost），
#      生产 http:// 会被浏览器拦截定位，前端已做降级提示（标记"定位未验证"）。
# COMMUNITY_NAME=知·社区
# COMMUNITY_CENTER_LAT=30.300000
# COMMUNITY_CENTER_LNG=120.100000
# COMMUNITY_RADIUS_M=500
