# ============================================================
# AI 社区网格员助手 · 环境变量模板
# 复制为 .env 后填写实际值。.env 已被 git 忽略，切勿提交。
# ============================================================

# ---- LLM 配置 ----
# DeepSeek / 兼容 OpenAI 协议的服务均可
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 账号数据加密（必填，缺失则服务拒绝启动）----
# AES-256-GCM 加密密钥，用于加密 secure/users.json.enc、sessions.json.enc。
# 必须为 64 位十六进制（= 32 字节）。
# 生成命令：
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# ⚠️ 安全须知：
#   1. 此密钥与 secure/ 下的加密文件必须分开备份，两者缺一不可用；
#   2. 密钥丢失 = 全部账号数据永久无法解密，无法找回；
#   3. 部署到云端后建议 chmod 600 .env，仅 root/应用用户可读。
DATA_ENCRYPTION_KEY=
