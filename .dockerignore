# 环境变量文件（防止 API Key 泄露进镜像）
.env

# Python 缓存文件
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Git 仓库
.git/
.github/

# 虚拟环境
.venv/
venv/

# 运行时数据目录（运行时生成，不打包进镜像）
data/
secure/

# Docker 构建文件（构建无关）
Dockerfile
deploy/Dockerfile*
deploy/docker-compose.yml
deploy/nginx.conf*
deploy/DEPLOY.md

# 项目文档（构建无关）
README.md
docs/

# 测试代码与覆盖率报告（不应进入生产镜像）
tests/
test/
*.bak
.coverage
htmlcov/

# 开发脚本（构建无关）
scripts/

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo

# Claude 项目配置（构建无关）
.claude/

# mypy 缓存（体积大，构建无关）
.mypy_cache/
